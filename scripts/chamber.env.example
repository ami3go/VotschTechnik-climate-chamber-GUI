# Climate Chamber pre-production configuration (allowlisted CHAMBER_* keys only).
# Copy next to the bundle or pass --config <path>. A real process variable
# always wins over a value in this file.
#
# UI port. Keep the default unless 8090 is taken.
CHAMBER_PORT=8090
# localhost (single workstation), lan or lab. LAN requires TLS, an exact public
# origin, and an explicit private client allowlist; a misconfiguration refuses
# to start rather than listening insecurely. lab is plain HTTP for a closed lab
# network (see README_LAB.md), e.g. CHAMBER_BIND_HOST=192.168.10.5.
CHAMBER_NETWORK_MODE=localhost
# Literal loopback IP to bind in localhost mode (rarely changed).
# CHAMBER_BIND_HOST=127.0.0.1
# CHAMBER_PUBLIC_ORIGIN=https://chamber.example:8443
# CHAMBER_ALLOWED_CLIENT_CIDRS=192.168.0.0/24
# CHAMBER_TLS_CERT=C:\ProgramData\ClimateChamber\server.crt
# CHAMBER_TLS_KEY=C:\ProgramData\ClimateChamber\server.key
#
# Physical Vötsch I/O is OFF unless ALL of these are set. It is a launch-time
# authorization, not a browser setting. Leave them commented for simulation.
# CHAMBER_HIL_ADDRESS=192.168.0.11
# CHAMBER_HIL_EXPECTED_SERIAL=58566207770010
# CHAMBER_HIL_TEMP_MIN_C=20
# CHAMBER_HIL_TEMP_MAX_C=30
# CHAMBER_HIL_ACK=SUPERVISED-PHYSICAL-HIL
#
# Isolated lab only: run physical profiles across the full envelope without
# the H02 permit workflow (README_LAB.md). Do not combine with CHAMBER_H02_*.
# CHAMBER_LAB_MODE=ISOLATED-LAB-UNATTENDED
# CHAMBER_LAB_MEASURED_MARGIN_C=5
# CHAMBER_LAB_GRADIENTS=on
#
# Supervised physical profile runs additionally need a site-signed H02 permit
# bound to the exact GUI/driver revisions, operator name and witness.
# CHAMBER_H02_PERMIT_FILE=C:\ProgramData\ClimateChamber\h02\permit.json
# CHAMBER_H02_TRUSTED_KEY=<base64 or hex Ed25519 site public key>
# CHAMBER_H02_WITNESS=<the witness named in the permit>
# CHAMBER_GUI_COMMIT=<40-hex revision recorded in the permit>
# CHAMBER_DRIVER_COMMIT=<40-hex driver revision recorded in the permit>
#
# Allow a scheduled task to run --backup-security/--verify-security without a
# terminal. Restores and credential bootstrap still require a local console.
# CHAMBER_UNATTENDED_MAINTENANCE=1
